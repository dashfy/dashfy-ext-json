{
  "name": "@dashfy/ext-json",
  "version": "0.1.0",
  "description": "Dashfy JSON extension - Display data from JSON APIs",
  "keywords": [
    "dashfy",
    "dashboard",
    "widgets",
    "extension",
    "json",
    "rest",
    "api"
  ],
  "homepage": "https://github.com/dashfy/dashfy-ext-json#readme",
  "bugs": {
    "url": "https://github.com/dashfy/dashfy-ext-json/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dashfy/dashfy-ext-json.git",
    "directory": "packages/ext-json"
  },
  "license": "MIT",
  "author": {
    "name": "Breno Polanski",
    "email": "breno.polanski@gmail.com",
    "url": "https://github.com/brenopolanski"
  },
  "type": "module",
  "dashfy": {
    "id": "json",
    "title": "JSON / REST",
    "categories": [
      "data"
    ],
    "widgets": [
      "CustomJson",
      "JsonKeys",
      "JsonStatus"
    ],
    "client": {
      "import": "@dashfy/ext-json",
      "factory": "createJsonClient",
      "mode": "poll"
    },
    "starter": [
      {
        "widget": "JsonStatus",
        "title": "API Status",
        "url": "https://api.example.com/health",
        "statuses": [
          {
            "assert": "equals(status, ok)",
            "status": "success",
            "label": "API Online"
          }
        ]
      }
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsup",
    "check:circular": "madge --circular --extensions ts,tsx src/",
    "clean": "rm -rf .turbo dist node_modules",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dashfy/types": "workspace:*",
    "@dashfy/ui": "workspace:*",
    "@dashfy/utils": "workspace:*",
    "eta": "^3.5.0"
  },
  "peerDependencies": {
    "lucide-react": "^0.454.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@dashfy/tsconfig": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.1",
    "@types/node": "^22.8.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^25.0.1",
    "lucide-react": "^0.454.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^2.1.4"
  }
}
